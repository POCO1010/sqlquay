{
  "name": "sqlquay",
  "displayName": "SQLQuay",
  "description": "%extension.description%",
  "author": "POCO1010",
  "repository": {"type":"git","url":"https://github.com/POCO1010/sqlquay.git"},
  "homepage": "https://github.com/POCO1010/sqlquay#readme",
  "bugs": {"url":"https://github.com/POCO1010/sqlquay/issues"},
  "version": "0.7.0",
  "publisher": "TomMajor",
  "license": "MIT",
  "engines": {"vscode": "^1.96.0"},
  "categories": ["Other"],
  "preview": true,
  "icon": "media/icon.png",
  "keywords": ["SQL","JDBC","DMS","MySQL","Doris","SelectDB","database"],
  "main": "./src/extension.cjs",
  "activationEvents": ["onLanguage:sql", "onLanguage:python", "onLanguage:markdown", "onLanguage:java", "onLanguage:javascript", "onLanguage:javascriptreact", "onLanguage:typescript", "onLanguage:typescriptreact"],
  "devDependencies": {"@vscode/vsce":"4.1.0"},
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check:public": "node scripts/check-public.cjs",
    "package": "node scripts/package.cjs",
    "vscode:prepublish": "node scripts/build-jdbc.cjs",
    "test:jdbc": "node test/jdbc-fixture.cjs",
    "test:dms": "node test/dms-fixture.cjs",
    "test:migration:host": "node test/run-migration-host.cjs",
    "package:migration": "node scripts/package-migration.cjs"
  },
  "contributes": {
    "viewsContainers": {"activitybar": [{"id":"dbw", "title":"SQLQuay", "icon":"media/database.svg"}]},
    "views": {"dbw":[{"id":"dbw.explorer","name":"%view.database%"}]},
    "commands": [
      {"command":"dbw.connect","title":"%command.connect%","category":"SQLQuay","icon":"$(add)"},
      {"command":"dbw.newQuery","title":"%command.newQuery%","category":"SQLQuay","icon":"$(new-file)"},
      {"command":"dbw.refresh","title":"%command.refresh%","category":"SQLQuay","icon":"$(refresh)"},
      {"command":"dbw.edit","title":"%command.edit%","category":"SQLQuay"},
      {"command":"dbw.addDmsDatabases","title":"%command.addDmsDatabases%","category":"SQLQuay","icon":"$(add)"},
      {"command":"dbw.remove","title":"%command.remove%","category":"SQLQuay"},
      {"command":"dbw.describe","title":"%command.describe%","category":"SQLQuay","icon":"$(symbol-property)"},
      {"command":"dbw.run","title":"%command.run%","category":"SQLQuay","icon":"$(play)"},
      {"command":"dbw.bindConnection","title":"%command.bindConnection%","category":"SQLQuay","icon":"$(database)","enablement":"resourceScheme == file || editorLangId == sql"},
      {"command":"dbw.setWorkspaceDdlConnection","title":"%command.setWorkspaceDdlConnection%","category":"SQLQuay"},
      {"command":"dbw.bindDdlConnection","title":"%command.bindDdlConnection%","category":"SQLQuay","enablement":"resourceScheme == file || editorLangId == sql"},
      {"command":"dbw.searchTables","title":"%command.searchTables%","category":"SQLQuay","icon":"$(search)"},
      {"command":"dbw.history","title":"%command.history%","category":"SQLQuay","icon":"$(history)"},
      {"command":"dbw.clearHistory","title":"%command.clearHistory%","category":"SQLQuay"},
      {"command":"dbw.unlock","title":"%command.unlock%","category":"SQLQuay"},
      {"command":"dbw.importLegacy","title":"%command.importLegacy%","category":"SQLQuay"}
    ],
    "menus": {
      "view/title":[{"command":"dbw.connect","when":"view == dbw.explorer","group":"navigation@1"},{"command":"dbw.setWorkspaceDdlConnection","when":"view == dbw.explorer","group":"settings@1"},{"command":"dbw.searchTables","when":"view == dbw.explorer","group":"navigation@2"},{"command":"dbw.history","when":"view == dbw.explorer","group":"navigation@3"}],
      "view/item/context":[
        {"command":"dbw.addDmsDatabases","when":"view == dbw.explorer && viewItem =~ /^dbw-(akConnection|dmsAccount)$/","group":"inline@1"},
        {"command":"dbw.newQuery","when":"view == dbw.explorer && viewItem =~ /^dbw-(connection|akConnection|schema)$/","group":"inline@1"},
        {"command":"dbw.refresh","when":"view == dbw.explorer && viewItem =~ /^dbw-(connection|akConnection|schema|tables)$/","group":"inline@2"},
        {"command":"dbw.describe","when":"view == dbw.explorer && viewItem == dbw-table","group":"inline"},
        {"command":"dbw.edit","when":"view == dbw.explorer && viewItem =~ /^dbw-(connection|akConnection|dmsAccount)$/","group":"connection@1"},
        {"command":"dbw.remove","when":"view == dbw.explorer && viewItem =~ /^dbw-(connection|akConnection|dmsAccount)$/","group":"connection@2"},
        {"command":"dbw.searchTables","when":"view == dbw.explorer && viewItem =~ /^dbw-(connection|akConnection|dmsAccount|schema|tables)$/","group":"navigation@1"}
      ],
      "editor/title":[{"command":"dbw.bindConnection","when":"dbw.runnableEditor","group":"navigation@8"},{"command":"dbw.run","when":"dbw.runnableEditor","group":"navigation@9"}],
      "editor/context":[{"command":"dbw.bindConnection","when":"dbw.runnableEditor","group":"dbw@1"},{"command":"dbw.run","when":"dbw.runnableEditor","group":"dbw@2"},{"command":"dbw.bindConnection","when":"editorHasSelection && resourceScheme == file && !dbw.runnableEditor","group":"dbw@1"},{"command":"dbw.run","when":"editorHasSelection && resourceScheme == file && !dbw.runnableEditor","group":"dbw@2"}]
    },
    "keybindings":[{"command":"dbw.run","key":"ctrl+enter","mac":"cmd+enter","when":"editorTextFocus && editorLangId == sql && dbw.runnableEditor"}],
    "configuration": {
      "title":"SQLQuay",
      "properties":{
        "dbWorkbench.driverJar":{"type":"string","default":"","scope":"machine","description":"%setting.driverJar%"},
        "dbWorkbench.javaPath":{"type":"string","default":"java","scope":"machine","description":"%setting.javaPath%"},
        "dbWorkbench.pythonPath":{"type":"string","default":"python3","scope":"machine","description":"%setting.pythonPath%"},
        "dbWorkbench.dmsWrapperPath":{"type":"string","default":"","scope":"machine","description":"%setting.dmsWrapperPath%"},
        "dbWorkbench.guardPath":{"type":"string","default":"","scope":"machine","description":"%setting.guardPath%"}
      }
    }
  }
}
